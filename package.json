{
  "name": "notepad",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @notepad/web",
    "dev:desktop": "npm run dev -w @notepad/desktop",
    "dev:mobile": "npm run dev -w @notepad/mobile",
    "dev:api": "npm run dev -w @notepad/api",
    "dev:cleanup": "npm run dev -w @notepad/cleanup",
    "build:desktop": "npm run build -w @notepad/desktop",
    "build:mobile": "npm run build -w @notepad/mobile",
    "package:desktop": "npm run package -w @notepad/desktop",
    "cap:sync": "npm run cap:sync -w @notepad/mobile",
    "deploy:web": "npm run deploy -w @notepad/web",
    "deploy:api": "npm run deploy -w @notepad/api",
    "deploy:cleanup": "npm run deploy -w @notepad/cleanup",
    "deploy:workers": "npm run validate:deploy-config && npm run deploy:api && npm run deploy:cleanup",
    "deploy:all": "npm run validate:deploy-config && npm run db:migrate:remote && npm run deploy:workers && npm run deploy:web",
    "validate:deploy-config": "node scripts/validate-deploy-config.mjs",
    "cf:d1:create": "wrangler d1 create notepad",
    "cf:r2:create": "wrangler r2 bucket create notepad-files",
    "cf:kv:create": "wrangler kv namespace create SITE_CONFIG",
    "secret:github:id": "wrangler secret put GITHUB_CLIENT_ID --config apps/api/wrangler.toml",
    "secret:github:secret": "wrangler secret put GITHUB_CLIENT_SECRET --config apps/api/wrangler.toml",
    "secret:token:signing": "wrangler secret put TOKEN_SIGNING_SECRET --config apps/api/wrangler.toml",
    "secret:totp:key": "wrangler secret put TOTP_ENCRYPTION_KEY --config apps/api/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply notepad --local --config apps/api/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply notepad --remote --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.98.0"
  }
}
