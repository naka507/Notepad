{
  "name": "@notepad/desktop",
  "productName": "Notepad",
  "version": "1.0.1",
  "description": "Notepad cross-platform desktop client for cloud notes, docs, sheets, files, and 2FA.",
  "homepage": "https://note.qqx.qzz.io",
  "author": "Notepad",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vue-tsc --noEmit && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "node scripts/dev-desktop.mjs",
    "package": "npm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.8.0",
    "@notepad/core": "1.0.1",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "docx": "^9.5.0",
    "dompurify": "^3.2.6",
    "element-plus": "^2.14.1",
    "jsqr": "^1.4.0",
    "mammoth": "^1.9.0",
    "marked": "^15.0.12",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "35.7.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
